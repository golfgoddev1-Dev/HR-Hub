# Cloudflare Pages response headers for static assets. The /api/* Function
# answers with its own headers (Cache-Control: no-store), so none of this
# applies there.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The approval page: the link token sits in the URL fragment; never cache the
# page or send a referrer from it.
/approve
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# Vite fingerprints everything under /assets, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed file names: cache for a month, then revalidate.
/fonts/*
  Cache-Control: public, max-age=2592000
/icon.svg
  Cache-Control: public, max-age=86400

# The service worker and the manifest must always be revalidated so an update
# reaches users on the next visit.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
