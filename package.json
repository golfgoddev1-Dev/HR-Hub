{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.js",
    "check:admin-hash": "node scripts/check-admin-hash.js",
    "check:supabase": "node scripts/check-supabase.js",
    "check:meeting-types": "node scripts/check-meeting-types.js",
    "issue:reset-code": "node scripts/issue-reset-code.js",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
