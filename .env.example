# ===== ส่วนที่ 1: สคริปต์ผู้ดูแลใน scripts/ (npm run issue:reset-code, npm run check:*) =====
# คัดลอกเป็น .env.local แล้วเติมค่า ห้าม commit .env.local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# กุญแจ HMAC สำหรับแฮชเลขบัตรประชาชน (สร้างด้วย: openssl rand -hex 32)
# ห้ามเปลี่ยนหลังนำเข้าข้อมูลแล้ว ไม่งั้นพนักงานทุกคนล็อกอินไม่ได้
NATIONAL_ID_PEPPER=
# กุญแจ HMAC สำหรับรหัส reset PIN (ต้องตรงกับ PIN_RESET_SECRET ของ Worker)
PIN_RESET_SECRET=

# ===== ส่วนที่ 2: Worker (worker/.dev.vars ในเครื่อง, `npx wrangler secret put <NAME>` บน production) =====
# ห้าม commit worker/.dev.vars; หนึ่งบรรทัดต่อหนึ่งตัวแปร รูปแบบ NAME=value เท่านั้น
# .dev.vars ต้องมี 4 ตัวจากส่วนที่ 1 ซ้ำด้วย (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# NATIONAL_ID_PEPPER, PIN_RESET_SECRET ค่าเดียวกัน) ร่วมกับตัวแปรด้านล่าง

# กุญแจ HMAC สำหรับแฮช PIN (ห้ามเปลี่ยนหลังมีข้อมูลจริง ไม่งั้นทุกคนล็อกอินไม่ได้)
PIN_PEPPER=
# ความลับสำหรับเข้ารหัสเลขบัตรประชาชนแบบถอดกลับได้ (AES-256-GCM) ห้ามเปลี่ยนหลังนำเข้าข้อมูล
NATIONAL_ID_ENC_KEY=
# ความลับสำหรับเซ็นลิงก์อนุมัติในอีเมล อย่างน้อย 32 ตัวอักษร
APPROVAL_LINK_SECRET=

# Web Push (VAPID) สร้างคู่คีย์นอก repository; subject เป็น mailto: หรือ URL ของหน่วยงาน
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Mail relay (Google Apps Script) ดู mail-relay/README.md
# URL ต้องเป็น https และโฮสต์ script.google.com; secret ต้องยาวอย่างน้อย 32 ตัวอักษร
APPS_SCRIPT_URL=
MAIL_RELAY_SECRET=

# ตั้ง false เฉพาะตอนทดสอบในเครื่องผ่าน http (ค่าอื่นหรือไม่ตั้ง = cookie แบบ Secure)
COOKIE_SECURE=
# ไม่บังคับ: ตั้งเมื่อเปิดใช้ Turnstile (ปิดเป็นค่าเริ่มต้น)
TURNSTILE_SECRET_KEY=

# ไม่ต้องใส่ใน .dev.vars/secret: ตัวแปรเหล่านี้อยู่ใน [vars] ของ worker/wrangler.toml
#   APP_ORIGIN          origin จริงของหน้าเว็บ ใช้สร้างลิงก์ QR/ลงทะเบียน
#   APP_PUBLIC_URL      origin จริงของหน้าเว็บ ใช้สร้างลิงก์ในอีเมล
#   AUTO_ABSENT_ENABLED ไม่ตั้งไว้ = ปิด; เปิดโดยเพิ่ม "true" (ตรงตัว) แล้ว deploy ใหม่
# ตัวเลือกของ Vite ในเครื่อง: VITE_API_TARGET (ค่าเริ่มต้น http://127.0.0.1:8787)
