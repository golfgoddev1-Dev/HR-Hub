# ค่าสำหรับสคริปต์ผู้ดูแลใน scripts/ (npm run issue:reset-code, npm run check:*)
# Worker อ่าน secrets จาก worker/.dev.vars (ในเครื่อง) หรือ Cloudflare secret (production) แยกต่างหาก
# คัดลอกเป็น .env.local แล้วเติมค่า ห้าม commit .env.local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# กุญแจ HMAC สำหรับแฮชเลขบัตรประชาชน (สร้างด้วย: openssl rand -hex 32)
# ห้ามเปลี่ยนหลังนำเข้าข้อมูลแล้ว ไม่งั้นพนักงานทุกคนล็อกอินไม่ได้
NATIONAL_ID_PEPPER=
# กุญแจ HMAC สำหรับรหัส reset PIN (ต้องตรงกับ PIN_RESET_SECRET ของ Worker)
PIN_RESET_SECRET=

# ใช้สร้างลิงก์ในอีเมล/QR (Worker + Pages Functions; ตั้งค่าใน worker/wrangler.toml ตอน deploy)
APP_ORIGIN=
