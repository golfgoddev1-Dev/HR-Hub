# ใช้เฉพาะฝั่ง server เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# กุญแจ HMAC สำหรับแฮชเลขบัตร ประชาชน (สร้างด้วย: openssl rand -hex 32)
# ห้ามเปลี่ยนหลังนำเข้าข้อมูลแล้ว ไม่งั้นพนักงานทุกคนล็อกอินไม่ได้
NATIONAL_ID_PEPPER=

# --- โมดูลลา (modules/leave) ---
# เมล: เลือก provider จาก env ห้าม hardcode ในโค้ด (ค่าเริ่มต้น none = ไม่ส่งเมลจริง)
LEAVE_MAIL_PROVIDER=none
# ถ้าใช้ resend
RESEND_API_KEY=
RESEND_FROM=
# ถ้าใช้ sendgrid
SENDGRID_API_KEY=
MAIL_FROM=

# Google Drive + Google Docs (service account) สำหรับใบรับรองแพทย์และ PDF ใบลา
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ใส่ PEM ทั้งหมด โดยแทนขึ้นบรรทัดใหม่ด้วย \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ไม่บังคับ (ไม่ใส่ = ไฟล์อยู่ root ของ Drive)
GOOGLE_DRIVE_FOLDER_ID=
# เทมเพลต Google Doc สำหรับ generate PDF ใบลา
GOOGLE_DOCS_TEMPLATE_ID=1WGfXZYv41EkZ4mAQQX_q3JBTKg3AndyH-uh1dkb3JUg

# ใช้สร้างลิงก์ในอีเมล (ไม่บังคับ)
APP_ORIGIN=
